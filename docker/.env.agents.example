# ========================================
# OpenRouter API Configuration (REQUIRED)
# ========================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ========================================
# Timeout Configuration (Optional)
# ========================================
# LLM agent timeout in seconds (Default: 90)
# Increase if LLM responses are taking longer
# LLM_TIMEOUT=90

# FastAPI request timeout in seconds (Default: 120)
# Should be greater than LLM_TIMEOUT to allow for processing time
# REQUEST_TIMEOUT=120
