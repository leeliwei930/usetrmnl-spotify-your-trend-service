# ========================================
# Spotify API Credentials (REQUIRED)
# ========================================
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ========================================
# Spotify OAuth Configuration
# ========================================
# Redirect URI - Must match what you configured in Spotify Dashboard
# For Docker: use the host machine's address (localhost or your domain)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/usetrmnl/spotify/callback

# ========================================
# Agent Service Configuration
# ========================================
# IMPORTANT: Use container name 'agents' for internal Docker network communication
# This allows the backend to connect to the agents service within the Docker network
AGENT_BASE_URL=http://agents:8000

# ========================================
# Server Configuration
# ========================================
# Port the server will listen on (inside container)
SERVER_PORT=8080

# Host the server will bind to
# MUST be 0.0.0.0 in Docker to accept connections from outside the container
SERVER_HOST=0.0.0.0

# ========================================
# CORS Configuration
# ========================================
# Allow requests from frontend (both container name and localhost)
# Add your production domains here as needed
CORS_ALLOW_ORIGINS=http://localhost:3000,http://frontend:3000,http://127.0.0.1:3000

# ========================================
# Timeout Configuration (Optional)
# ========================================
# All timeout values are in seconds

# Timeout for HTTP client when calling the agent service
# AGENT_CLIENT_TIMEOUT=30

# Timeout for agent request context (should be less than client timeout)
# AGENT_REQUEST_TIMEOUT=25

# Echo server read timeout (time to read request)
# SERVER_READ_TIMEOUT=30

# Echo server write timeout (time to write response)
# SERVER_WRITE_TIMEOUT=30
