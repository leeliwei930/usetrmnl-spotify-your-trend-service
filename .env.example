# ========================================
# Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# The .env file will be automatically loaded when starting the application

# ========================================
# Spotify API Credentials (REQUIRED)
# ========================================
# Get these from: https://developer.spotify.com/dashboard
# 1. Go to the Spotify Developer Dashboard
# 2. Create a new application
# 3. Copy the Client ID and Client Secret

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ========================================
# Spotify OAuth Configuration
# ========================================
# Redirect URI - Must match what you configured in Spotify Dashboard
# This is where Spotify redirects users after authorization
# Default: http://localhost:8080/usetrmnl/spotify/callback

SPOTIFY_REDIRECT_URI=http://localhost:8080/usetrmnl/spotify/callback

# ========================================
# Server Configuration (Optional)
# ========================================
# These have sensible defaults if not specified

# Port the server will listen on
# Default: 8080
# SERVER_PORT=8080

# Host the server will bind to
# Default: localhost
# SERVER_HOST=localhost

# ========================================
# Agent Service Configuration (Optional)
# ========================================
# Base URL for the Python agent service
# This is used to call the behind-the-lyrics LLM agent
# Default: http://localhost:8000

AGENT_BASE_URL=http://localhost:8000

# ========================================
# Timeout Configuration (Optional)
# ========================================
# All timeout values are in seconds

# Timeout for HTTP client when calling the agent service
# Default: 30
# AGENT_CLIENT_TIMEOUT=30

# Timeout for agent request context (should be less than client timeout)
# Default: 25
# AGENT_REQUEST_TIMEOUT=25

# Echo server read timeout (time to read request)
# Default: 30
# SERVER_READ_TIMEOUT=30

# Echo server write timeout (time to write response)
# Default: 30
# SERVER_WRITE_TIMEOUT=30

